---
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="kb-brand" aria-label={siteTitle}>
	<svg class="kb-mark" viewBox="0 0 40 40" width="36" height="36" aria-hidden="true">
		<rect width="40" height="40" rx="11" fill="var(--kb-blue)"></rect>
		<rect x="8" y="12" width="24" height="17" rx="4" fill="none" stroke="#fff" stroke-width="2.6"></rect>
		<path d="M8 17.5h24" stroke="#fff" stroke-width="2.6"></path>
		<circle cx="26.5" cy="23.5" r="3" fill="var(--kb-warm)"></circle>
	</svg>
	<span class="kb-brand-text" translate="no">
		<span class="kb-brand-name">EUDI Wallet RP</span>
		<span class="kb-brand-sub">Knowledge Base</span>
	</span>
</a>

<style>
	.kb-brand {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		min-width: 0;
		text-decoration: none;
		color: var(--sl-color-white);
	}
	.kb-mark {
		flex-shrink: 0;
	}
	.kb-brand-text {
		display: flex;
		flex-direction: column;
		line-height: 1.1;
		min-width: 0;
		white-space: nowrap;
	}
	.kb-brand-name {
		font-weight: 800;
		font-size: 1.15rem;
		letter-spacing: -0.01em;
	}
	.kb-brand-sub {
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--sl-color-gray-3);
	}
</style>
