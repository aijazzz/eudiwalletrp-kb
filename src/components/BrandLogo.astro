---
/**
 * Site mark (concept 4: storefront + verified ID) plus wordmark.
 * Pass sizing classes (e.g. `h-9 w-auto`).
 */
const { class: className } = Astro.props;
interface Props {
  class?: string;
}
---

<span class={`inline-flex items-center gap-x-2.5 ${className ?? ''}`}>
  <svg
    class="h-full w-auto shrink-0 dark:hidden"
    viewBox="0 0 64 64"
    fill="none"
    aria-hidden="true"
  >
    <path d="M10 20H54V54A5 5 0 0 1 49 59H15A5 5 0 0 1 10 54Z" fill="#1E3A8A"
    ></path>
    <path
      d="M8 5H56A3 3 0 0 1 59 8V18A6.75 6.75 0 0 1 45.50 18A6.75 6.75 0 0 1 32.00 18A6.75 6.75 0 0 1 18.50 18A6.75 6.75 0 0 1 5.00 18V8A3 3 0 0 1 8 5Z"
      fill="#F2B33D"></path>
    <rect x="17" y="30" width="30" height="21" rx="4.5" fill="#FFFFFF"></rect>
    <path
      d="M24.5 40.5 30 46 40 36"
      fill="none"
      stroke="#1E3A8A"
      stroke-width="5"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <svg
    class="hidden h-full w-auto shrink-0 dark:block"
    viewBox="0 0 64 64"
    fill="none"
    aria-hidden="true"
  >
    <path d="M10 20H54V54A5 5 0 0 1 49 59H15A5 5 0 0 1 10 54Z" fill="#5B82EC"
    ></path>
    <path
      d="M8 5H56A3 3 0 0 1 59 8V18A6.75 6.75 0 0 1 45.50 18A6.75 6.75 0 0 1 32.00 18A6.75 6.75 0 0 1 18.50 18A6.75 6.75 0 0 1 5.00 18V8A3 3 0 0 1 8 5Z"
      fill="#F2B33D"></path>
    <rect x="17" y="30" width="30" height="21" rx="4.5" fill="#FFFFFF"></rect>
    <path
      d="M24.5 40.5 30 46 40 36"
      fill="none"
      stroke="#1E3A8A"
      stroke-width="5"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <span class="flex flex-col leading-none whitespace-nowrap">
    <span
      class="text-base font-bold tracking-tight text-neutral-800 dark:text-neutral-100"
      >EUDI Wallet RP</span
    >
    <span class="mt-0.5 text-xs font-medium text-neutral-600 dark:text-neutral-400"
      >Relying Party Knowledge Base</span
    >
  </span>
</span>
