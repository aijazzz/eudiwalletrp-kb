---
import mark from '@images/starlight/mark.svg?raw';
import type { Props } from '@astrojs/starlight/props';

const main = '/';
const docs = '/getting-started/';
---

<span class="site-title flex">
  <a class="main-logo flex" href={main} aria-label="EUDI Wallet RP Knowledge Base home">
    <span class="mark" set:html={mark} />
    <span class="wordmark">EUDI Wallet RP</span>
  </a>
  <a class="docs-logo" href={docs}>Docs</a>
</span>

<style>
  .site-title {
    gap: 1rem;
    margin-right: 1rem;
  }
  .site-title a {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .flex {
    display: flex;
    align-items: center;
  }
  .main-logo {
    gap: 0.6rem;
  }
  .mark :global(svg) {
    width: 2rem;
    height: 2rem;
  }
  .wordmark {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--sl-color-white);
    white-space: nowrap;
  }
  .docs-logo {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--sl-color-gray-2);
    border-inline-start: 1px solid var(--sl-color-gray-5);
    padding-inline-start: 1rem;
  }
  .site-title a:focus-visible {
    outline: 0;
  }
  .site-title a:hover > :global(*) {
    transform: translateY(calc(0.1rem * -1));
    transition: transform 250ms cubic-bezier(0.33, 1, 0.68, 1);
  }
</style>
