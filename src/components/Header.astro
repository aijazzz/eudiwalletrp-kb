---
// Wraps Starlight's default header and adds a prominent primary navigation row.
import Default from '@astrojs/starlight/components/Header.astro';
import { sections } from '../nav';

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
---

<div class="kb-header">
	<div class="kb-top"><Default /></div>
	<nav class="kb-nav print:hidden" aria-label="Main">
		<ul>
			{
				sections.map(({ label, href }) => (
					<li>
						<a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</div>

<script>
	// On narrow screens, make sure the active section tab is visible in the scrollable nav row.
	const active = document.querySelector<HTMLElement>('.kb-nav a[aria-current="page"]');
	const nav = active?.closest<HTMLElement>('.kb-nav');
	if (active && nav && nav.scrollWidth > nav.clientWidth) {
		nav.scrollLeft = active.offsetLeft - nav.clientWidth / 2 + active.offsetWidth / 2;
	}
</script>

<style>
	.kb-header {
		display: flex;
		flex-direction: column;
		height: 100%;
	}
	.kb-top {
		height: var(--kb-top-h);
		padding-block: var(--sl-nav-pad-y);
	}
	.kb-nav {
		height: var(--kb-subnav-h);
		margin-inline: calc(-1 * var(--sl-nav-pad-x));
		padding-inline: var(--sl-nav-pad-x);
		border-top: 1px solid var(--sl-color-hairline-light);
		overflow-x: auto;
		scrollbar-width: none;
		/* Fade the right edge on narrow screens to hint that the row scrolls. */
		mask-image: linear-gradient(to right, #000 calc(100% - 2rem), transparent);
	}
	.kb-nav::-webkit-scrollbar {
		display: none;
	}
	ul {
		display: flex;
		gap: 0.25rem;
		height: 100%;
		margin: 0;
		padding: 0 2rem 0 0;
		list-style: none;
		align-items: stretch;
	}
	a {
		display: flex;
		align-items: center;
		height: 100%;
		padding-inline: 0.85rem;
		white-space: nowrap;
		font-size: var(--sl-text-base);
		font-weight: 650;
		color: var(--sl-color-white);
		text-decoration: none;
		border-bottom: 3px solid transparent;
		transition: color 0.15s, border-color 0.15s;
	}
	li:first-child a {
		padding-inline-start: 0;
	}
	a:hover {
		color: var(--sl-color-text-accent);
		border-bottom-color: var(--kb-warm);
	}
	a[aria-current='page'] {
		color: var(--sl-color-text-accent);
		border-bottom-color: var(--sl-color-text-accent);
	}
	@media (min-width: 72rem) {
		.kb-nav {
			mask-image: none;
		}
		a {
			font-size: var(--sl-text-lg);
			padding-inline: 1.1rem;
		}
	}
</style>
